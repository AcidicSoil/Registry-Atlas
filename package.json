{
  "dependencies": {
    "@stylexjs/stylex": "0.19.1",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/web": "0.1.0-beta.13",
    "postgres": "^3.4.9",
    "react": "18.3.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.14.0",
    "@oxlint/plugins": "1.87.0",
    "@shadcn/lint": "file:tools/oxlint/shadcn-lint",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "^26.6.4",
    "dependency-cruiser": "18.6.0",
    "e2e": "0.20.0",
    "eslint": "9.39.1",
    "knip": "6.44.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.87.0",
    "postcss": "8.5.29",
    "postcss-value-parser": "4.2.0",
    "react-doctor": "0.9.18",
    "react-grab": "^0.1.47",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "39.0.1",
    "typescript": "~5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "yaml": "2.9.0"
  },
  "name": "registry-atlas",
  "private": true,
  "scripts": {
    "audit:dependencies": "pnpm run lint:audit",
    "build": "pnpm run build:check-runtime-data && pnpm run build:production",
    "build:bundle": "pnpm exec vite build",
    "build:check-runtime-data": "node scripts/check-runtime-data.mjs",
    "build:compile": "pnpm exec tsc",
    "build:prepare-runtime-data": "node scripts/build-runtime-data.mjs",
    "build:production": "pnpm run build:compile && pnpm run build:bundle && pnpm run build:spa-fallback && pnpm run build:sbom",
    "build:sbom": "node scripts/generate-sbom.mjs",
    "build:source-pages": "pnpm run build:source-pages-report && pnpm run build:source-pages-index",
    "build:source-pages-index": "node scripts/build-source-page-index.mjs",
    "build:source-pages-report": "node scripts/verify-component-pages.mjs --report-only --report .instance/component-verification-queue.json",
    "build:spa-fallback": "node scripts/create-pages-spa-fallback.mjs",
    "build:validate-data": "node scripts/validate-registry-data.mjs",
    "check": "pnpm run lint && pnpm run typecheck",
    "db": "pnpm run db:status",
    "db:backup": "bash scripts/backup-local-postgres.sh",
    "db:check": "node scripts/check-postgres.mjs",
    "db:down": "node scripts/manage-local-postgres.mjs down",
    "db:migrate": "node scripts/migrate-postgres-schema.mjs",
    "db:reconcile-source-evidence": "node scripts/reconcile-runtime-source-evidence.mjs --apply",
    "db:restore-check": "bash scripts/check-local-postgres-backup.sh",
    "db:setup": "node scripts/manage-local-postgres.mjs setup",
    "db:status": "node scripts/manage-local-postgres.mjs status",
    "db:up": "node scripts/manage-local-postgres.mjs up",
    "dev": "pnpm run build:check-runtime-data && pnpm run dev:serve",
    "dev:preview": "pnpm exec vite preview",
    "dev:serve": "pnpm exec vite",
    "format:check": "pnpm run lint:format",
    "format:write": "pnpm run lint:format-write",
    "lint": "pnpm run lint:anti-slop && pnpm run lint:deps && pnpm run lint:react-doctor && pnpm run lint:complexity && pnpm run lint:styles && pnpm run lint:stylex && pnpm run lint:unused && pnpm run lint:format",
    "lint:anti-slop": "pnpm exec oxlint .",
    "lint:audit": "pnpm audit --audit-level low",
    "lint:boundaries": "pnpm exec depcruise src",
    "lint:commit": "node scripts/check-commit-message.mjs --range HEAD^..HEAD",
    "lint:complexity": "cccc --table src/registry-explorer",
    "lint:deps": "pnpm exec depcruise src tests --config .dependency-cruiser.cjs",
    "lint:format": "pnpm exec oxfmt --check .",
    "lint:format-write": "pnpm exec oxfmt --write .",
    "lint:react-doctor": "pnpm exec react-doctor . --blocking warning --no-telemetry",
    "lint:styles": "pnpm exec stylelint \"public/styles/**/*.css\" \"src/**/*.css\"",
    "lint:stylex": "pnpm exec eslint \"src/**/*.stylex.ts\" --max-warnings 0",
    "lint:unused": "pnpm exec knip",
    "sync": "node scripts/sync-shadcn-registries.mjs",
    "sync:catalog-evidence": "node scripts/sync-registry-catalog-evidence.mjs",
    "sync:import": "node scripts/import-registry-catalog.mjs",
    "sync:registries": "pnpm run sync",
    "sync:registry-icons": "node scripts/discover-registry-icons.mjs",
    "test": "pnpm run build:check-runtime-data && pnpm run test:unit",
    "test:anti-slop-gate": "node scripts/verify-anti-slop-gate.mjs",
    "test:boundaries": "node scripts/verify-deep-module-boundaries.mjs",
    "test:browser": "node scripts/check-browser-acceptance.mjs",
    "test:complexity-gate": "node scripts/verify-complexity-gate.mjs",
    "test:component-pages": "pnpm run test:component-pages-run && pnpm run build:source-pages",
    "test:component-pages-run": "node scripts/verify-component-pages.mjs --max-pages 20 --max-per-registry 3 --delay-ms 1200 --report .instance/component-verification-queue.json",
    "test:contract": "node scripts/check-product-contract.mjs",
    "test:e2e": "pnpm run build && pnpm run test:e2e-run",
    "test:e2e-run": "pnpm exec e2e run",
    "test:local": "pnpm exec vitest run --testTimeout 30000 --exclude tests/registry-explorer/catalogClassificationCli.test.ts --exclude tests/registry-explorer/postgresStorage.test.ts --exclude tests/registry-explorer/registryDiscoveryPostgres.test.ts --exclude tests/registry-explorer/verifyComponentPages.test.ts --exclude tests/registry-explorer/verifyRegistryPatterns.test.ts",
    "test:registry-patterns": "pnpm run test:registry-patterns-run && pnpm run build:source-pages",
    "test:registry-patterns-run": "node scripts/verify-registry-patterns.mjs --verify-only --max-registries 20 --samples 2",
    "test:unit": "pnpm exec vitest run --testTimeout 30000",
    "test:watch": "pnpm exec vitest",
    "typecheck": "pnpm run typecheck:app && pnpm run typecheck:tests",
    "typecheck:app": "pnpm exec tsc --noEmit",
    "typecheck:tests": "pnpm exec tsc --noEmit -p tsconfig.test.json",
    "verify": "pnpm run build:prepare-runtime-data && pnpm run build:check-runtime-data && pnpm run lint:audit && pnpm run lint && pnpm run typecheck:tests && pnpm run test:unit && pnpm run db:check && pnpm run test:contract && pnpm run build:validate-data && pnpm run build:production",
    "verify:local": "pnpm run build:check-runtime-data && pnpm run lint:audit && pnpm run lint && pnpm run typecheck:tests && pnpm run test:local && pnpm run build:production"
  },
  "type": "module",
  "version": "0.0.0"
}
