{
  "name": "registry-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "TMPDIR=${TMPDIR:-/tmp} vitest run",
    "test:watch": "TMPDIR=${TMPDIR:-/tmp} vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "sync:registries": "node scripts/sync-shadcn-registries.mjs",
    "sync:registry-icons": "node scripts/discover-registry-icons.mjs",
    "import:catalog": "node scripts/import-registry-catalog.mjs",
    "validate:data": "node scripts/validate-registry-data.mjs",
    "check:product-contract": "node scripts/check-product-contract.mjs",
    "browser:acceptance": "node scripts/check-browser-acceptance.mjs",
    "verify": "pnpm typecheck && pnpm typecheck:test && pnpm test && pnpm check:product-contract && pnpm validate:data && pnpm build",
    "build": "tsc && vite build && node scripts/create-pages-spa-fallback.mjs",
    "preview": "vite preview",
    "all": "pnpm sync:registries && pnpm verify",
    "sync:catalog-evidence": "node scripts/sync-registry-catalog-evidence.mjs",
    "prepare:runtime-db": "node scripts/build-runtime-databases.mjs --output-dir public/data",
    "predev": "pnpm prepare:runtime-db",
    "prebuild": "pnpm prepare:runtime-db"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.11",
    "react-grab": "^0.1.47",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "2.20.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "^1.14.2"
  }
}
