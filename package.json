{
  "dependencies": {
    "@codesandbox/sandpack-react": "2.20.0",
    "postgres": "^3.4.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.14.0",
    "@oxlint/plugins": "1.87.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "dependency-cruiser": "18.6.0",
    "e2e": "0.20.0",
    "oxlint": "1.87.0",
    "react-doctor": "0.9.18",
    "react-grab": "^0.1.47",
    "typescript": "~5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "yaml": "2.9.0"
  },
  "name": "registry-atlas",
  "private": true,
  "scripts": {
    "audit:dependencies": "pnpm audit --audit-level low",
    "browser:acceptance": "node scripts/check-browser-acceptance.mjs",
    "build": "tsc && vite build && node scripts/create-pages-spa-fallback.mjs && node scripts/generate-sbom.mjs",
    "check:postgres": "node scripts/check-postgres.mjs",
    "check:product-contract": "node scripts/check-product-contract.mjs",
    "dev": "vite",
    "import:catalog": "node scripts/import-registry-catalog.mjs",
    "lint": "pnpm lint:anti-slop && pnpm lint:deps && pnpm lint:complexity",
    "lint:anti-slop": "oxlint .",
    "lint:complexity": "cccc src/registry-explorer",
    "lint:deps": "depcruise src tests --config .dependency-cruiser.cjs",
    "lint:react-doctor": "react-doctor src --blocking warning --no-telemetry",
    "migrate:postgres-schema": "node scripts/migrate-postgres-schema.mjs",
    "prebuild": "pnpm check:runtime-data",
    "predev": "pnpm check:runtime-data",
    "prepare:runtime-data": "node scripts/build-runtime-data.mjs",
    "pretest": "pnpm check:runtime-data",
    "preview": "vite preview",
    "sync": "node scripts/project-tasks.mjs sync",
    "test": "TMPDIR=${TMPDIR:-/tmp} vitest run --testTimeout 30000",
    "test:boundaries": "node scripts/verify-deep-module-boundaries.mjs",
    "test:complexity-gate": "node scripts/verify-complexity-gate.mjs",
    "test:watch": "TMPDIR=${TMPDIR:-/tmp} vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "validate:data": "node scripts/validate-registry-data.mjs",
    "verify": "pnpm prepare:runtime-data && pnpm audit:dependencies && pnpm lint:anti-slop && pnpm lint:deps && pnpm lint:react-doctor && pnpm lint:complexity && pnpm typecheck && pnpm typecheck:test && pnpm test && pnpm check:postgres && pnpm check:product-contract && pnpm validate:data && pnpm build",
    "test:anti-slop-gate": "node scripts/verify-anti-slop-gate.mjs",
    "check:runtime-data": "node scripts/check-runtime-data.mjs",
    "verify:local": "pnpm check:runtime-data && pnpm audit:dependencies && pnpm lint:anti-slop && pnpm lint:deps && pnpm lint:react-doctor && pnpm lint:complexity && pnpm typecheck && pnpm typecheck:test && pnpm test:local && pnpm build",
    "test:local": "TMPDIR=${TMPDIR:-/tmp} vitest run --testTimeout 30000 --exclude tests/registry-explorer/catalogClassificationCli.test.ts --exclude tests/registry-explorer/postgresStorage.test.ts --exclude tests/registry-explorer/registryDiscoveryPostgres.test.ts --exclude tests/registry-explorer/verifyComponentPages.test.ts --exclude tests/registry-explorer/verifyRegistryPatterns.test.ts",
    "db": "node scripts/project-tasks.mjs db",
    "test:e2e": "pnpm build && e2e run",
    "lint:commit": "node scripts/check-commit-message.mjs --range HEAD^..HEAD"
  },
  "type": "module",
  "version": "0.0.0"
}
