{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortImports": false,
  "sortTailwindcss": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.output/**",
    "**/out/**",
    "**/target/**",
    "**/generated/**",
    "AGENTS.md",
    ".github/copilot-instructions.md",
    ".agents/**",
    ".stackforge/**",
    ".worktrees/**",
    "tools/anti-slop/**",
    "tools/oxlint/**",
    "tools/stylelint/**",
    "tools/pylint/**",
    "tools/eslint/anti-slop-stylex/**",
    ".design/standards.json",
    ".design/reviews/*.review.html",
    ".design/evidence/css-cascade-parity-2026-10-30.json",
    ".design/evidence/design-current/browser-observations.json",
    ".design/evidence/design-current/verification.md"
  ]
}
