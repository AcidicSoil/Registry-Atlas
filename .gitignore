# =============================================================================
# Claude Code + OrchestKit
#
# Project-owned configuration is tracked.
# Runtime, generated, session, telemetry, cache, report, and local state is not.
#
# IMPORTANT:
# Runtime/generated exclusions MUST remain at the end of this section so
# earlier ! negation rules cannot accidentally re-include generated artifacts.
# =============================================================================

# -----------------------------------------------------------------------------
# Project-owned assets
# -----------------------------------------------------------------------------

!.claude/settings.json

!.claude/rules/
!.claude/rules/**

!.claude/skills/
!.claude/skills/**

!.claude/commands/
!.claude/commands/**

!.claude/output-styles/
!.claude/output-styles/**

!.claude/agents/
!.claude/agents/*.md

!.claude/agent-memory/
!.claude/agent-memory/**

!.claude/hooks/
!.claude/hooks/**

!CLAUDE.md
!.claude/CLAUDE.md
!.mcp.json
!.worktreeinclude


# =============================================================================
# Runtime / generated / local-only state
#
# KEEP THIS BLOCK AFTER ALL ! NEGATION RULES ABOVE.
# =============================================================================

# -----------------------------------------------------------------------------
# Claude Code local-only configuration
# -----------------------------------------------------------------------------

.claude/settings.local.json
CLAUDE.local.md
.claude-local/

# -----------------------------------------------------------------------------
# Native Claude Code worktrees
# -----------------------------------------------------------------------------

.claude/worktrees/
.worktrees/

# -----------------------------------------------------------------------------
# Sessions / handoffs / chains
# -----------------------------------------------------------------------------

.claude/HANDOFF.md
.claude/HANDOFF.md.consumed
.claude/chain/

**/.claude/HANDOFF.md
**/.claude/HANDOFF.md.consumed

.claude/session/
.claude/context/session/
!.claude/context/session/.gitkeep
!.claude/session/.gitkeep

.claude/context/handoffs/
.claude/context/verification-queue/
.claude/context/quality_gate_review_evidence.json

# -----------------------------------------------------------------------------
# Telemetry / logs / reports
# -----------------------------------------------------------------------------

.claude/telemetry/
.claude/logs/

# Hook-generated output, including security reports such as Bandit.
.claude/hooks/logs/
**/.claude/hooks/logs/

# Nested hook runtime state
**/hooks/.claude/

# Generic generated report/output directories below .claude
.claude/**/reports/
.claude/**/report/
.claude/**/artifacts/
.claude/**/generated/
.claude/**/output/
.claude/**/outputs/

# -----------------------------------------------------------------------------
# Ephemeral runtime state
# -----------------------------------------------------------------------------

.claude/state/
.claude/feedback/
.claude/orchestration/
.claude/memory/

**/.claude/memory/

.claude/agents/session-state.json
.claude/agents/activity/

# -----------------------------------------------------------------------------
# Coordination runtime
# -----------------------------------------------------------------------------

.claude/coordination/IMPLEMENTATION_REPORT.json
.claude/coordination/heartbeats/
.claude/coordination/locks/
.claude/coordination/decision-log.json
.claude/coordination/.decision-sync-state.json
.claude/coordination/work-registry.json
.claude/coordination/.claude.db

# -----------------------------------------------------------------------------
# Local OrchestKit overrides / instance state
# -----------------------------------------------------------------------------

.claude/hook-overrides.json
.claude/.instance_env
.claude/agent-memory-local/

.claude/.negative-count-*
.claude/.comm-style-counter
.claude/.satisfaction-counter
.claude/scheduled_tasks.lock

# -----------------------------------------------------------------------------
# Generic transient files anywhere below .claude
# -----------------------------------------------------------------------------

.claude/**/*.lock
.claude/**/*.tmp
.claude/**/*.temp
.claude/**/*.bak
.claude/**/*.log
.claude/**/*.pid
.claude/**/*.db
.claude/**/*.db-shm
.claude/**/*.db-wal

.claude/**/.cache/
.claude/**/cache/
.claude/**/tmp/
.claude/**/temp/.codex/config.toml
graph-infra/.env
graph-infra/bin/
