":"registry/blog/components/mdx/table.tsx","type":"registry:component","target":"components/mdx/table.tsx"}]},{"name":"blog-routes","type":"registry:block","title":"AgentBlog routes","description":"Fully prerendered /blog index, post, category, tag, and author routes. generateStaticParams returns every slug, there is no client component in the article render path, and every segment spreads shared metadata defaults so og:site_name and max-snippet survive Next.js's shallow merge.","categories":["blog","seo","routes"],"registryDependencies":["@agentblog/blog-core","@agentblog/blog-schema","@agentblog/blog-ui","@agentblog/mdx-components","@agentblog/source-mdx","@agentblog/seo-routes","@agentblog/eeat-pages"],"files":[{"path":"registry/blog/app/blog/layout.tsx","type":"registry:page","target":"app/blog/layout.tsx"},{"path":"registry/blog/app/blog/page.tsx","type":"registry:page","target":"app/blog/page.tsx"},{"path":"registry/blog/app/blog/opengraph-image.tsx","type":"registry:page","target":"app/blog/opengraph-image.tsx"},{"path":"registry/blog/app/blog/[slug]/page.tsx","type":"registry:page","target":"app/blog/[slug]/page.tsx"},{"path":"registry/blog/app/blog/[slug]/opengraph-image.tsx","type":"registry:page","target":"app/blog/[slug]/opengraph-image.tsx"},{"path":"registry/blog/app/blog/category/[slug]/page.tsx","type":"registry:page","target":"app/blog/category/[slug]/page.tsx"},{"path":"registry/blog/app/blog/tag/[slug]/page.tsx","type":"registry:page","target":"app/blog/tag/[slug]/page.tsx"},{"path":"registry/blog/app/authors/layout.tsx","type":"registry:page","target":"app/authors/layout.tsx"},{"path":"registry/blog/app/authors/[slug]/page.tsx","type":"registry:page","target":"app/authors/[slug]/page.tsx"},{"path":"registry/blog/lib/og-card.tsx","type":"registry:lib","target":"lib/og-card.tsx"}]},{"name":"seo-routes","type":"registry:block","title":"AgentBlog SEO routes","description":"sitemap.xml built from real content dates rather than the build clock, an environment-guarded robots.txt that declares your AI access preferences, an RSS 2.0 feed, and a 404 that returns a real 404.","categories":["blog","seo"],"registryDependencies":["@agentblog/blog-core"],"files":[{"path":"registry/blog/app/sitemap.ts","type":"registry:page","target":"app/sitemap.ts"},{"path":"registry/blog/app/robots.ts","type":"registry:page","target":"app/robots.ts"},{"path":"registry/blog/app/feed.xml/route.ts","type":"registry:page","target":"app/feed.xml/route.ts"},{"path":"registry/blog/app/llms.txt/route.ts","type":"registry:page","target":"app/llms.txt/route.ts"},{"path":"registry/blog/app/not-found.tsx","type":"registry:page","target":"app/not-found.tsx"}]},{"name":"publish-webhook","type":"registry:block","title":"AgentBlog publish webhook","description":"A publish endpoint that revalidates the metadata routes as well as the page routes, because sitemap.xml and feed.xml are cached route handlers that a naive webhook leaves stale, and then submits the URL to IndexNow with the response codes surfaced rather than swallowed.","categories":["blog","seo","api"],"registryDependencies":["@agentblog/blog-core"],"files":[{"path":"registry/blog/app/api/publish/route.ts","type":"registry:page","target":"app/api/publish/route.ts"},{"path":"registry/blog/lib/indexnow.ts","type":"registry:lib","target":"lib/indexnow.ts"}]},{"name":"source-mdx","type":"registry:block","title":"AgentBlog MDX content source","description":"Posts as MDX files in your repository, which is the storage option a coding agent can genuinely maintain. Includes the content source adapter, the single MDX compilation point, two local remark plugins, and two seed posts written to the GEO playbook so they double as the format specification.","categories":["blog","content","mdx"],"dependencies":["github-slugger","gray-matter","next-mdx-remote-client","rehype-autolink-headings","rehype-pretty-code","rehype-slug","remark-gfm","shiki"],"devDependencies":["@types/mdast","vfile"],"registryDependencies":["@agentblog/blog-core","@agentblog/mdx-components"],"files":[{"path":"registry/blog/lib/sources/mdx.ts","type":"registry:lib","target":"lib/sources/mdx.ts"},{"path":"registry/blog/lib/render-mdx.tsx","type":"registry:lib","target":"lib/render-mdx.tsx"},{"path":"registry/blog/lib/mdx-plugins/remark-extract-toc.ts","type":"registry:lib","target":"lib/mdx-plugins/remark-extract-toc.ts"},{"path":"registry/blog/lib/mdx-plugins/remark-answer-capsule.ts","type":"registry:lib","target":"lib/mdx-plugins/remark-answer-capsule.ts"},{"path":"registry/blog/content/authors.json","type":"registry:file","target":"~/content/authors.json"},{"path":"registry/blog/content/categories.json","type":"registry:file","target":"~/content/categories.json"},{"path":"registry/blog/content/blog/how-ai-search-engines-read-your-blog.mdx","type":"registry:file","target":"~/content/blog/how-ai-search-engines-read-your-blog.mdx"},{"path":"registry/blog/content/blog/what-makes-an-ai-engine-cite-your-post.mdx","type":"registry:file","target":"~/content/blog/what-makes-an-ai-engine-cite-your-post.mdx"}]},{"name":"eeat-pages","type":"registry:block","title":"AgentBlog trust pages","description":"An editorial policy page with a real review and corrections process. This is the Trust surface a search quality rater looks for and almost no blog has one, which makes it unusually cheap to differentiate on.","categories":["blog","seo","eeat"],"registryDependencies":["@agentblog/blog-core"],"files":[{"path":"registry/blog/app/editorial-policy/page.tsx","type":"registry:page","target":"app/editorial-policy/page.tsx"}]},{"name":"blog-minimal","type":"registry:block","title":"AgentBlog without the webhook or the agent kit","description":"The full blog, minus the two items a reader never sees: no /api/publish route and no secrets in .env, and nothing written into .claude/. Everything else matches @agentblog/blog. It cannot be smaller than that: the routes share one sitemap and one layout, app/sitemap.ts emits category, author, tag, and /editorial-policy URLs, and the blog layout links /editorial-policy and /feed.xml, so dropping those routes would publish a sitemap of 404s rather than a smaller blog. Install this when you want the blog without a publish endpoint to secure.","categories":["blog","seo"],"registryDependencies":["@agentblog/blog-core","@agentblog/blog-schema","@agentblog/blog-ui","@agentblog/mdx-components","@agentblog/blog-routes","@agentblog/source-mdx"]},{"name":"blog","type":"registry:block","title":"AgentBlog","description":"A complete, production-ready blog for Next.js 16 that AI search engines can actually read. Fully prerendered routes, a typed schema.org graph, sitemap and RSS and IndexNow, Open Graph images, answer capsules and question headings for retrieval, and an editorial policy page. Inherits your shadcn theme rather than imposing one.","categories":["blog","seo","geo","content"],"registryDependencies":["@agentblog/blog-core","@agentblog/blog-schema","@agentblog/blog-ui","@agentblog/mdx-components","@agentblog/blog-routes","@agentblog/seo-routes","@agentblog/publish-webhook","@agentblog/source-mdx","@agentblog/eeat-pages","@agentblog/agent-kit"]},{"name":"agent-kit","type":"registry:block","title":"AgentBlog agent kit","description":"Seven skills that take a blog from install to published: finish the setup for your site, research what to write with real search and AI citation data, plan the topic clusters, write posts to the GEO playbook, refresh them without falsifying dateModified, audit before publish, and publish with the IndexNow response code actually read. Installs into your project's .claude/skills directory, so any agent working in this repository picks them up. Also available as a Claude Code plugin and through npx skills add.","categories":["blog","agents","claude-code"],"files":[{"path":"registry/agent/skills/agentblog-setup/SKILL.md","type":"registry:file","target":"~/.claude/skills/agentblog-setup/SKILL.md"},{"path":"registry/agen